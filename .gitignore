# ══════════════════════════════════════════════════════════════
# 13. PACKAGE MANAGER LOCKS
#     Commit only ONE lock file for your chosen package manager.
#     Uncomment the lock files you do NOT use to exclude them.
# ══════════════════════════════════════════════════════════════

# Uncomment if you use npm (and want to exclude yarn/pnpm locks):
# yarn.lock
# pnpm-lock.yaml

# Uncomment if you use yarn (and want to exclude npm/pnpm locks):
# package-lock.json
# pnpm-lock.yaml

# Uncomment if you use pnpm (and want to exclude npm/yarn locks):
# package-lock.json
# yarn.lock


# ══════════════════════════════════════════════════════════════
# 14. PROJECT-SPECIFIC — CampusAlert
# ══════════════════════════════════════════════════════════════

# Local DB snapshots / SQLite dev databases
*.db
*.db-journal
*.db-shm
*.db-wal

# Generated assets
src/assets/generated/

# Script utilities (not part of app source)
src/project_tree.py

# Sentry / Crash reporting source maps (uploaded at build time)
sentry.properties

