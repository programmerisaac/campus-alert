# campusalert/.env.example
# Copy this to .env and fill in real values — never commit .env

# Default Django backend URL (internet mode)
API_BASE_URL=http://your-server.com/api/v1

# LAN/hotspot fallback IP (updated at runtime via server dialog)
LAN_BASE_URL=http://192.168.1.100:8000/api/v1

# WebSocket endpoint for LAN delivery
WS_BASE_URL=ws://192.168.1.100:8000/ws/alerts/

